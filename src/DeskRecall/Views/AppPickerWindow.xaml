<Window x:Class="DeskRecall.Views.AppPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Programm hinzufügen" Width="480" Height="560" MinWidth="440" MinHeight="420"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <Grid Margin="20,16,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent">
                <Image Source="{StaticResource LogoImage}" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" Text="Programm hinzufügen" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="SearchBox" Padding="10,7" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" />
                <TextBlock x:Name="SearchHint" IsHitTestVisible="False" Text="Suchen …" Foreground="{StaticResource TextFaintBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Content="Durchsuchen…" Margin="8,0,0,0" Height="32" Click="Browse_Click" ToolTip="Eine .exe- oder .lnk-Datei wählen" />
            </Grid>

            <Border Grid.Row="2" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8">
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="Programme werden geladen …" Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" Margin="16" />
                    <ListBox x:Name="AppList" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MouseDoubleClick="AppList_MouseDoubleClick" SelectionChanged="AppList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4,8,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Width="22" Height="22">
                                        <Border CornerRadius="4" Background="{StaticResource AccentSoftBrush}" />
                                        <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                                    </Grid>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource TextFaintBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource SecondaryButton}" Content="Abbrechen" MinWidth="96" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button x:Name="OkLaunchButton" Style="{StaticResource SecondaryButton}" Content="Hinzufügen und starten" MinWidth="150" Margin="0,0,8,0" IsEnabled="False" Click="OkLaunch_Click"
                        ToolTip="Anheften und sofort auf diesem Desktop starten" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" Content="Hinzufügen" MinWidth="104" IsDefault="True" IsEnabled="False" Click="Ok_Click"
                        ToolTip="Auf diesem Desktop anheften (Enter)" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
