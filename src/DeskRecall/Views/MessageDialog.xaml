<Window x:Class="DeskRecall.Views.MessageDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DeskRecall" Width="440" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="True"
        WindowStartupLocation="CenterScreen" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}" UseLayoutRounding="True">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="12" Margin="12">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <StackPanel Margin="22,18,22,18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12" MouseLeftButtonDown="Title_MouseLeftButtonDown" Background="Transparent">
                <Image Source="{StaticResource LogoImage}" Width="18" Height="18" />
                <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="10,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock x:Name="MessageText" TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" LineHeight="19" />
            <Border x:Name="DetailsBorder" Visibility="Collapsed" Margin="0,12,0,0" Background="{StaticResource InputBrush}" CornerRadius="6" Padding="10,6" MaxHeight="180">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="DetailsText" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextDimBrush}" LineHeight="18" />
                </ScrollViewer>
            </Border>
            <StackPanel x:Name="PromptPanel" Visibility="Collapsed" Margin="0,12,0,0">
                <TextBox x:Name="InputBox" MaxLength="60" KeyDown="InputBox_KeyDown" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button x:Name="CancelButton" Style="{StaticResource SecondaryButton}" MinWidth="96" Margin="0,0,8,0" Click="Cancel_Click" IsCancel="True" />
                <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" MinWidth="96" Click="Ok_Click" IsDefault="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
