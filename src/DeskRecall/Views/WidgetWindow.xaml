<Window x:Class="DeskRecall.Views.WidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DeskRecall.ViewModels"
        xmlns:ui="clr-namespace:DeskRecall.Views"
        xmlns:m="clr-namespace:DeskRecall.Core.Models;assembly=DeskRecall.Core"
        Title="DeskRecall"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Focusable="False"
        Width="316" Height="720" Topmost="True"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{StaticResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <!-- Zeile einer App innerhalb einer Desktop-Karte -->
        <DataTemplate x:Key="AppRowTemplate" DataType="{x:Type vm:AppRowViewModel}">
            <StackPanel>
                <Border x:Name="Row" Background="Transparent" CornerRadius="6" Padding="6,4" Margin="0,1" Cursor="Hand"
                        ToolTip="{Binding ToolTipText}" ToolTipService.InitialShowDelay="700"
                        PreviewMouseLeftButtonDown="Row_PreviewMouseLeftButtonDown" PreviewMouseMove="Row_PreviewMouseMove"
                        MouseLeftButtonUp="Row_MouseLeftButtonUp" ContextMenuOpening="Row_ContextMenuOpening">
                    <Border.ContextMenu>
                        <ContextMenu />
                    </Border.ContextMenu>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="18" Height="18" VerticalAlignment="Center">
                            <Border CornerRadius="4" Background="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="&#xE737;" Style="{StaticResource IconText}" FontSize="10" Foreground="{StaticResource AccentLightBrush}" />
                            <Image Source="{Binding Icon}" Width="18" Height="18" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                        <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding AppName}" TextTrimming="CharacterEllipsis" FontSize="12.5" />
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{StaticResource TextFaintBrush}" Visibility="Collapsed" />
                        </StackPanel>
                        <Border x:Name="CountBadge" Grid.Column="2" CornerRadius="8" Background="{StaticResource HoverBrush}" Padding="6,1" Margin="0,0,2,0" VerticalAlignment="Center"
                                Visibility="{Binding HasMultipleWindows, Converter={StaticResource BoolToVis}}" ToolTip="Fensterliste auf- oder zuklappen">
                            <TextBlock Text="{Binding WindowCount}" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                        </Border>
                        <TextBlock x:Name="AppChevron" Grid.Column="3" Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Margin="0,0,4,0"
                                   Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center"
                                   Visibility="{Binding HasMultipleWindows, Converter={StaticResource BoolToVis}}"
                                   ToolTip="Fensterliste auf- oder zuklappen" />
                        <TextBlock x:Name="WinGlyph" Grid.Column="4" Text="&#xE8A7;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource TextFaintBrush}" ToolTip="Fenster in den Vordergrund holen" />
                    </Grid>
                </Border>
                <Border x:Name="SubHost" Margin="27,0,0,0" ClipToBounds="True"
                        Opacity="0" Visibility="Collapsed" RenderTransformOrigin="0,0"
                        ui:ExpandChrome.IsOpen="{Binding IsWindowsExpanded}">
                    <Border.RenderTransform>
                        <ScaleTransform ScaleY="0" />
                    </Border.RenderTransform>
                    <ItemsControl ItemsSource="{Binding WindowItems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:WindowRecord}">
                                <Border x:Name="SubRow" Background="Transparent" CornerRadius="4" Padding="6,2" Margin="0,0" Cursor="Hand"
                                        ToolTip="{Binding DisplayTitle}" ToolTipService.InitialShowDelay="500"
                                        MouseLeftButtonUp="WindowSubRow_MouseLeftButtonUp">
                                    <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" FontSize="11.5"
                                               Foreground="{StaticResource TextDimBrush}" />
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="SubRow" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="SubRow" Property="Background" Value="{StaticResource HoverBrush}" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding State}" Value="Minimized">
                                        <Setter TargetName="SubRow" Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{StaticResource HoverBrush}" />
                    <Setter TargetName="WinGlyph" Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                    <Setter TargetName="AppChevron" Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsWindowsExpanded}" Value="True">
                    <Setter TargetName="AppChevron" Property="Text" Value="&#xE70E;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMinimized}" Value="True">
                    <Setter TargetName="Row" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRunning}" Value="False">
                    <Setter TargetName="Row" Property="Opacity" Value="0.7" />
                    <Setter TargetName="TitleText" Property="Visibility" Value="Visible" />
                    <Setter TargetName="WinGlyph" Property="Text" Value="&#xE768;" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Desktop-Karte -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:DesktopCardViewModel}">
            <Border x:Name="Card" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="{StaticResource CardRadius}" Margin="0,0,0,8" Padding="10,8,8,8" AllowDrop="True"
                    DragEnter="Card_DragEnter" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop"
                    ContextMenuOpening="Card_ContextMenuOpening">
                <Border.ContextMenu>
                    <ContextMenu />
                </Border.ContextMenu>
                <StackPanel>
                    <Grid x:Name="CardHeader" Background="Transparent" Cursor="Hand" MouseLeftButtonUp="CardHeader_MouseLeftButtonUp" MinHeight="26">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Ellipse x:Name="ActiveDot" Width="6" Height="6" Fill="{StaticResource AccentLightBrush}" Margin="0,0,7,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="Num" Grid.Column="1" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextFaintBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock x:Name="NameLabel" Grid.Column="2" Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisInv}}" ToolTip="Doppelklick zum Umbenennen" />
                        <TextBox x:Name="RenameBox" Grid.Column="2" Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" FontWeight="SemiBold"
                                 Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}" MaxLength="60"
                                 IsVisibleChanged="RenameBox_IsVisibleChanged" KeyDown="RenameBox_KeyDown" LostKeyboardFocus="RenameBox_LostKeyboardFocus" />
                        <Border Grid.Column="3" CornerRadius="9" Background="{StaticResource HoverBrush}" MinWidth="22" Height="18" Padding="6,0" Margin="6,0,2,0" VerticalAlignment="Center" ToolTip="Programme auf diesem Desktop">
                            <TextBlock x:Name="CountText" Text="{Binding AppCount}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Button x:Name="Chevron" Grid.Column="4" Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="10" Content="&#xE70E;"
                                Command="{Binding DataContext.ToggleCardCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"
                                ToolTip="Ein-/Ausklappen" />
                    </Grid>
                    <StackPanel Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRowTemplate}" />
                        <TextBlock Text="Keine Fenster – Programm hinzufügen oder hierher ziehen" FontSize="11.5" Foreground="{StaticResource TextFaintBrush}" Margin="6,2,0,0"
                                   Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}" />
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="4,2,0,0" Padding="2,1"
                                Opacity="0.75"
                                Command="{Binding DataContext.AddAppCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}" ToolTip="Programm auf diesem Desktop anheften">
                            <TextBlock FontSize="11" Foreground="{StaticResource TextFaintBrush}">
                                <Run Text="+" /><Run Text="  Programm hinzufügen" />
                            </TextBlock>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource CardActiveBrush}" />
                    <Setter TargetName="Card" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#8B6CF0" BlurRadius="16" ShadowDepth="0" Opacity="0.45" />
                        </Setter.Value>
                    </Setter>
                    <Setter TargetName="ActiveDot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                    <Setter TargetName="CountText" Property="Foreground" Value="{StaticResource AccentLightBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExpanded}" Value="False">
                    <Setter TargetName="Chevron" Property="Content" Value="&#xE70D;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Card" Property="Background" Value="{StaticResource AccentSoftBrush}" />
                    <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                </DataTrigger>
                <Trigger SourceName="CardHeader" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource TextDimBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Nummer in der eingeklappten Leiste -->
        <DataTemplate x:Key="StripItemTemplate" DataType="{x:Type vm:DesktopCardViewModel}">
            <Border x:Name="Chip" Width="28" Height="28" CornerRadius="7" Margin="0,3" Background="{StaticResource HoverBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    Cursor="Hand" ToolTip="{Binding DisplayName}" AllowDrop="True" MouseLeftButtonUp="StripChip_MouseLeftButtonUp"
                    DragEnter="Card_DragEnter" DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                <TextBlock x:Name="ChipText" Text="{Binding ShortNumber}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{StaticResource AccentGradient}" />
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentLightBrush}" />
                </DataTrigger>
                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ChipText" Property="Foreground" Value="{StaticResource TextBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="Root">
        <Grid.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Grid.LayoutTransform>

        <!-- ================= Ausgeklapptes Widget ================= -->
        <Border x:Name="ExpandedPanel" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="12,10,12,12"
                Background="#D91E1B26" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Kopfzeile -->
                <Grid Grid.Row="0" Margin="2,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Image Source="{StaticResource LogoImage}" Width="20" Height="20" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="DeskRecall" FontFamily="{StaticResource DisplayFont}" FontSize="15" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource IconButton}" Content="&#xE713;" ToolTip="Einstellungen" Click="Settings_Click" />
                        <ToggleButton Style="{StaticResource IconToggleButton}" Content="&#xE718;" ToolTip="Immer im Vordergrund" IsChecked="{Binding IsPinned, Mode=OneWay}" Command="{Binding TogglePinCommand}" />
                        <Button x:Name="CollapseButton" Style="{StaticResource IconButton}" Content="&#xE921;" ToolTip="Einklappen" Click="Collapse_Click" />
                    </StackPanel>
                </Grid>

                <!-- Status -->
                <Border Grid.Row="1" CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Margin="0,0,0,10">
                    <StackPanel>
                        <Grid Background="Transparent" Cursor="Hand" MouseLeftButtonUp="Status_MouseLeftButtonUp" Margin="10,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource GreenBrush}" VerticalAlignment="Center">
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#3DD68C" BlurRadius="8" ShadowDepth="0" Opacity="0.7" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="&#xE753;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="9,0,7,0" />
                            <TextBlock Grid.Column="2" Text="{Binding StatusText}" FontSize="12.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="3" Text="{Binding StatusTime}" FontSize="12.5" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="6,0,6,0" />
                            <TextBlock x:Name="StatusChevron" Grid.Column="4" Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Foreground="{StaticResource TextDimBrush}" />
                        </Grid>
                        <StackPanel Visibility="{Binding IsStatusOpen, Converter={StaticResource BoolToVis}}" Margin="10,0,10,9">
                            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,7" />
                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource DimText}" FontSize="11.5" LineHeight="17" />
                        </StackPanel>
                        <Grid Visibility="{Binding IsRestoring, Converter={StaticResource BoolToVis}}" Margin="10,0,10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar IsIndeterminate="True" Height="3" Foreground="{StaticResource AccentBrush}" Background="{StaticResource LineBrush}" BorderThickness="0" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Abbrechen" Margin="8,0,0,0" Command="{Binding CancelRestoreCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Row="2">
                    <!-- Hinweis, wenn Desktops nicht verwaltet werden können -->
                    <Border CornerRadius="8" Background="#22F5B451" BorderBrush="#55F5B451" BorderThickness="1" Padding="10,7" Margin="0,0,0,10"
                            Visibility="{Binding CanManageDesktops, Converter={StaticResource BoolToVisInv}}">
                        <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{StaticResource WarnBrush}"
                                   Text="Virtuelle Desktops können auf dieser Windows-Version nur gelesen werden. Fenster werden trotzdem positioniert – Details unter Einstellungen → Diagnose." />
                    </Border>
                    <Border CornerRadius="8" Background="{StaticResource AccentSoftBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" Padding="10,7" Margin="0,0,0,10"
                            Visibility="{Binding Updates.NoticeText, Converter={StaticResource NullToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Updates.NoticeText}" FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="Ihre Daten bleiben erhalten." FontSize="11" Foreground="{StaticResource TextDimBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <Button Grid.Column="1" Style="{StaticResource LinkButton}" Content="Später" Command="{Binding Updates.DismissCommand}" Margin="8,0,4,0" VerticalAlignment="Center" />
                            <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Content="Aktualisieren" Command="{Binding Updates.InstallCommand}" Height="28" Padding="10,0" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Desktop-Karten -->
                <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,2,0" Margin="0,0,-4,0" CanContentScroll="True">
                    <ItemsControl x:Name="CardsList" ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource CardTemplate}" Margin="0,2,4,0" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <!-- Aktionen -->
                <StackPanel Grid.Row="4" Margin="0,6,0,0">
                    <UniformGrid Columns="4" Margin="0,0,0,8">
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,4,0" Command="{Binding AddAppCommand}" ToolTip="Programm zum aktiven Desktop hinzufügen">
                            <TextBlock Text="&#xE8B9;" Style="{StaticResource IconText}" />
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="0,0,4,0" Command="{Binding AddDesktopCommand}" ToolTip="Neuen Desktop erstellen">
                            <TextBlock Text="&#xE710;" Style="{StaticResource IconText}" />
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="2,0,2,0" Command="{Binding DuplicateDesktopCommand}" ToolTip="Aktiven Desktop duplizieren (Name und Explorer-Ordner)">
                            <TextBlock Text="&#xE8C8;" Style="{StaticResource IconText}" />
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" Height="32" Margin="4,0,0,0" Command="{Binding DeleteDesktopCommand}" ToolTip="Aktiven Desktop schließen (Fenster wandern zum Nachbar-Desktop)">
                            <TextBlock Text="&#xE74D;" Style="{StaticResource IconText}" />
                        </Button>
                    </UniformGrid>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RestoreCommand}" ToolTip="Ausgewähltes Profil bzw. letzte Sitzung wiederherstellen">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE768;" Style="{StaticResource IconText}" FontSize="12" Margin="0,0,8,0" />
                                <TextBlock Text="Wiederherstellen" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Command="{Binding SaveCommand}" ToolTip="Aktuellen Zustand jetzt sichern">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,7,0" />
                                <TextBlock Text="Sichern" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox x:Name="ProfileCombo" Height="34" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile, Mode=TwoWay}" ToolTip="Aktives Profil">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE81E;" Style="{StaticResource IconText}" FontSize="12" Foreground="{StaticResource AccentLightBrush}" Margin="0,0,8,0" />
                                        <TextBlock Text="Profil: " Foreground="{StaticResource TextDimBrush}" />
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button x:Name="HistoryButton" Grid.Column="1" Style="{StaticResource SquareButton}" Height="34" Width="34" Margin="8,0,0,0" Content="&#xE81C;"
                                Command="{Binding ToggleHistoryCommand}" ToolTip="Sitzungsverlauf" />
                        <Popup x:Name="HistoryPopup" Grid.ColumnSpan="2" PlacementTarget="{Binding ElementName=HistoryButton}" Placement="Top" VerticalOffset="-8"
                               HorizontalOffset="-238" AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                               IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}">
                            <Border Width="272" MaxHeight="380" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="Sitzungsverlauf" FontWeight="SemiBold" Margin="6,2,0,8" />
                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock Text="Noch keine Sicherungen vorhanden." Style="{StaticResource DimText}" Margin="6,0,0,6"
                                                       Visibility="{Binding History.Count, Converter={StaticResource ZeroToVis}}" />
                                            <ItemsControl ItemsSource="{Binding History}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:HistoryItemViewModel}">
                                                        <Border x:Name="H" CornerRadius="6" Padding="8,6" Background="Transparent" ToolTip="{Binding KindText}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Text="&#xE823;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0" />
                                                                <StackPanel Grid.Column="1">
                                                                    <TextBlock Text="{Binding When}" FontSize="12.5" />
                                                                    <TextBlock Text="{Binding Summary}" FontSize="11" Foreground="{StaticResource TextDimBrush}" />
                                                                </StackPanel>
                                                                <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="&#xE777;" ToolTip="Diese Sicherung wiederherstellen"
                                                                        Command="{Binding DataContext.RestoreHistoryCommand, ElementName=HistoryButton}" CommandParameter="{Binding}" />
                                                            </Grid>
                                                        </Border>
                                                        <DataTemplate.Triggers>
                                                            <Trigger SourceName="H" Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="H" Property="Background" Value="{StaticResource HoverBrush}" />
                                                            </Trigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Eingeklappte Leiste (≈40 px) ================= -->
        <Border x:Name="StripPanel" Visibility="Collapsed" Width="44" CornerRadius="12" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                Background="#D91E1B26" Padding="0,10" VerticalAlignment="Center" MouseEnter="Panel_MouseEnter" MouseLeave="Panel_MouseLeave">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="{StaticResource LogoImage}" Width="20" Height="20" Margin="0,0,0,8" Cursor="Hand" MouseLeftButtonUp="Expand_Click" ToolTip="DeskRecall öffnen" />
                <Ellipse x:Name="StripDot" Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,0,8" HorizontalAlignment="Center" ToolTip="{Binding StatusText}" />
                <ItemsControl ItemsSource="{Binding Cards}" ItemTemplate="{StaticResource StripItemTemplate}" Focusable="False" />
                <Button Style="{StaticResource IconButton}" Content="&#xE710;" Margin="0,6,0,0" Command="{Binding AddDesktopCommand}" ToolTip="Neuer Desktop" />
                <Button Style="{StaticResource IconButton}" Margin="0,2,0,0" Click="Expand_Click" ToolTip="Ausklappen">
                    <TextBlock x:Name="ExpandGlyph" Text="&#xE76B;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ================= Auto-Ausblenden: unsichtbarer Rand-Auslöser ================= -->
        <Border x:Name="EdgeTrigger" Visibility="Collapsed" Background="#02FFFFFF" MouseEnter="Edge_MouseEnter" />
    </Grid>
</Window>
