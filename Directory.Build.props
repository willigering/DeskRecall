<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <!-- Version: 1.2.4, Build-Nummer kommt aus build-number.txt (wird von build.ps1/build.sh bei jedem Build erhöht; CI erhöht sie nicht) -->
    <BuildNumber Condition="'$(BuildNumber)'=='' and Exists('$(MSBuildThisFileDirectory)build-number.txt')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)build-number.txt').Trim())</BuildNumber>
    <BuildNumber Condition="'$(BuildNumber)'==''">1</BuildNumber>
    <Version>1.2.4</Version>
    <AssemblyVersion>1.2.4.0</AssemblyVersion>
    <FileVersion>1.2.4.$(BuildNumber)</FileVersion>
    <InformationalVersion>1.2.4 (Build $(BuildNumber))</InformationalVersion>

    <Authors>Willi Gering</Authors>
    <Company>Gering Digital</Company>
    <Product>DeskRecall</Product>
    <Copyright>Copyright © 2026 Willi Gering, Gering Digital</Copyright>
    <Description>DeskRecall – Windows Desktop &amp; Session Manager</Description>
  </PropertyGroup>
</Project>
